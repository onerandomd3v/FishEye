---
import { siteContent } from '../content/site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteContent.description} />
    <title>{siteContent.title}</title>
    <style>
      :root {
        font-family: Inter, system-ui, sans-serif;
        color: #111;
        background: #fff;
      }
      body {
        margin: 0;
      }
      a {
        color: inherit;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3rem 1.25rem;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #d7d7d7;
        padding-bottom: 1.25rem;
      }
      h1 {
        font-size: clamp(2.8rem, 7vw, 5rem);
        letter-spacing: -0.055em;
        line-height: 1.08;
        max-width: 900px;
        margin: 8rem 0 1.4rem;
      }
      p {
        color: #595959;
        line-height: 1.7;
        max-width: 650px;
      }
      .button {
        display: inline-block;
        background: #111;
        color: #fff;
        padding: 1rem 1.4rem;
        text-decoration: none;
        margin-top: 1.8rem;
        border-radius: 8px;
      }
      footer {
        margin-top: 11rem;
        border-top: 1px solid #d7d7d7;
        padding-top: 1.5rem;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <strong>FishEye</strong><span>Context-aware risk triage</span>
      </header>
      <h1>Not every unusual action is a threat.</h1>
      <p>
        FishEye helps security analysts focus on meaningful signals by
        evaluating employee access activity in context, rather than treating
        every anomaly as malicious.
      </p>
      <a class="button" href="#about">How it works</a>
      <section id="about" style="margin-top:10rem">
        <h2>Less noise. Better signal.</h2>
        <p>
          Understand behaviour, prioritize findings and evaluate results against
          clear baselines.
        </p>
      </section>
      <footer><p>{siteContent.disclaimer}</p></footer>
    </main>
  </body>
</html>
