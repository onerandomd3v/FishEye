# Local-only demo login. Available only with the Next.js development server.
FISHEYE_DEMO_EMAIL=analyst@fisheye.local
FISHEYE_DEMO_PASSWORD=

# Shared session encryption key; generate at least 32 random bytes.
FISHEYE_SESSION_SECRET=

# OIDC authorization-code flow (leave unset for the local demo login).
FISHEYE_OIDC_ISSUER=
FISHEYE_OIDC_CLIENT_ID=
FISHEYE_OIDC_CLIENT_SECRET=
FISHEYE_OIDC_SCOPES=openid profile email
FISHEYE_OIDC_RESOURCE=
FISHEYE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
FISHEYE_CONSOLE_URL=http://localhost:3000

# Private server-to-server API URL. Never expose this or tokens to the browser.
API_INTERNAL_URL=http://127.0.0.1:8000
