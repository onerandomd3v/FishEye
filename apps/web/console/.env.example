# One shared analyst account. Keep these server-only and out of PUBLIC_ variables.
FISHEYE_DEMO_EMAIL=analyst@fisheye.local
FISHEYE_DEMO_PASSWORD=

# Token signing key; set the same random value in the console and API environments.
FISHEYE_SESSION_SECRET=
FISHEYE_CONSOLE_URL=http://127.0.0.1:3000

# Private server-to-server API URL. Never expose this or tokens to the browser.
API_INTERNAL_URL=http://127.0.0.1:8000
