DATABASE_URL=postgresql+psycopg://fisheye:fisheye_dev_only@localhost:5432/fisheye
FISHEYE_TEST_DATABASE_URL=postgresql+psycopg://fisheye:fisheye_dev_only@localhost:5432/fisheye_test
FISHEYE_ENV=development
FISHEYE_SYNTHETIC_ONLY=true
FISHEYE_ENABLE_DEV_CSV_VALIDATION=0
FISHEYE_ENABLE_DEV_CSV_IMPORT=0
FISHEYE_ENABLE_DEV_DATASET_READS=0
FISHEYE_ENABLE_DEV_EVALUATION_RUNS=0
FISHEYE_ARTIFACT_DIR=var/fisheye-artifacts
FISHEYE_ARTIFACT_ENCRYPTION_KEY=
# Shared by the console and API to sign and verify short-lived demo tokens.
FISHEYE_SESSION_SECRET=
# Single analyst credentials for the synthetic-data demo. Do not reuse a real password.
FISHEYE_DEMO_EMAIL=analyst@fisheye.local
FISHEYE_DEMO_PASSWORD=
API_INTERNAL_URL=http://localhost:8000
