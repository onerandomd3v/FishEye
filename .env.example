DATABASE_URL=postgresql+psycopg://fisheye:fisheye_dev_only@localhost:5432/fisheye
FISHEYE_TEST_DATABASE_URL=postgresql+psycopg://fisheye:fisheye_dev_only@localhost:5432/fisheye_test
FISHEYE_ENV=development
FISHEYE_SYNTHETIC_ONLY=true
FISHEYE_ENABLE_DEV_CSV_VALIDATION=0
FISHEYE_ENABLE_DEV_CSV_IMPORT=0
FISHEYE_ENABLE_DEV_DATASET_READS=0
FISHEYE_ENABLE_DEV_EVALUATION_RUNS=0
FISHEYE_ENABLE_LOCAL_DATA_RESET=0
FISHEYE_ARTIFACT_DIR=var/fisheye-artifacts
# Hosted API and worker: set storage to r2 and supply the private bucket endpoint,
# bucket name, bucket-limited access key, and secret in the service secret manager.
FISHEYE_ARTIFACT_STORAGE=local
FISHEYE_R2_ENDPOINT_URL=
FISHEYE_R2_BUCKET=fisheye-artifacts
FISHEYE_R2_PREFIX=fisheye
FISHEYE_R2_ACCESS_KEY_ID=
FISHEYE_R2_SECRET_ACCESS_KEY=
FISHEYE_ARTIFACT_ENCRYPTION_KEY=
# CSV import, dataset reads, and evaluation runs are currently local-development-only.
# Do not expose these routes in shared environments without an approved architecture decision.
FISHEYE_CORS_ORIGINS=http://127.0.0.1:3000
# Shared by the console and API to sign and verify short-lived demo tokens.
FISHEYE_SESSION_SECRET=
# Console-only credentials for the synthetic-data demo. Keep server-side and do not reuse a real password.
FISHEYE_DEMO_EMAIL=analyst@fisheye.local
FISHEYE_DEMO_PASSWORD=
API_INTERNAL_URL=http://localhost:8000
