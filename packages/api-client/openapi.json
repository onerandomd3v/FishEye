{
  "openapi": "3.1.0",
  "info": {
    "title": "FishEye API",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets/imports/validate": {
      "post": {
        "summary": "Validate Dataset Import",
        "description": "Development-only schema check; this endpoint does not import or score data.",
        "operationId": "validate_dataset_import_api_v1_datasets_imports_validate_post",
        "parameters": [
          {
            "name": "X-FishEye-Synthetic-Data-Confirmed",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Fisheye-Synthetic-Data-Confirmed"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetValidationResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets/imports": {
      "post": {
        "summary": "Import Synthetic Dataset",
        "description": "Persist a validated synthetic CSV as an immutable dev-only dataset artifact.",
        "operationId": "import_synthetic_dataset_api_v1_datasets_imports_post",
        "parameters": [
          {
            "name": "X-FishEye-Synthetic-Data-Confirmed",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Fisheye-Synthetic-Data-Confirmed"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetImportResponse"
                }
              }
            }
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetImportResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsvImportValidationError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets": {
      "get": {
        "summary": "Get Datasets",
        "description": "Development-only, paginated listing of imported dataset metadata.",
        "operationId": "get_datasets_api_v1_datasets_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetListResponse"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/datasets/{dataset_id}": {
      "get": {
        "summary": "Get Dataset Metadata",
        "description": "Development-only read of one dataset's provenance metadata.",
        "operationId": "get_dataset_metadata_api_v1_datasets__dataset_id__get",
        "parameters": [
          {
            "name": "dataset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dataset Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetMetadataResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": ["detail"],
        "title": "ApiErrorResponse"
      },
      "CsvImportValidationDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": ["code", "errors"],
        "title": "CsvImportValidationDetail"
      },
      "CsvImportValidationError": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/CsvImportValidationDetail"
          }
        },
        "type": "object",
        "required": ["detail"],
        "title": "CsvImportValidationError"
      },
      "DatasetImportResponse": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "employee_day_count": {
            "type": "integer",
            "title": "Employee Day Count"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          },
          "synthetic_only": {
            "type": "boolean",
            "title": "Synthetic Only",
            "default": true
          },
          "run_created": {
            "type": "boolean",
            "title": "Run Created",
            "default": false
          },
          "risk_calculated": {
            "type": "boolean",
            "title": "Risk Calculated",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "dataset_id",
          "status",
          "sha256",
          "manifest_sha256",
          "schema_version",
          "row_count",
          "employee_day_count",
          "created_at",
          "created"
        ],
        "title": "DatasetImportResponse"
      },
      "DatasetListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DatasetMetadataResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": ["items", "limit", "offset", "total", "has_more"],
        "title": "DatasetListResponse"
      },
      "DatasetMetadataResponse": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "imported"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "employee_day_count": {
            "type": "integer",
            "title": "Employee Day Count"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "preparation_status": {
            "type": "string",
            "title": "Preparation Status"
          },
          "analysis_manifest_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Manifest Sha256"
          },
          "synthetic_only": {
            "type": "boolean",
            "title": "Synthetic Only",
            "default": true
          },
          "evaluation_status": {
            "type": "string",
            "title": "Evaluation Status",
            "default": "not_run"
          },
          "ground_truth_usage": {
            "type": "string",
            "title": "Ground Truth Usage",
            "default": "evaluation_only"
          },
          "run_created": {
            "type": "boolean",
            "title": "Run Created",
            "default": false
          },
          "risk_calculated": {
            "type": "boolean",
            "title": "Risk Calculated",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "dataset_id",
          "sha256",
          "manifest_sha256",
          "schema_version",
          "row_count",
          "employee_day_count",
          "created_at",
          "preparation_status"
        ],
        "title": "DatasetMetadataResponse"
      },
      "DatasetValidationResponse": {
        "properties": {
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "employee_day_count": {
            "type": "integer",
            "title": "Employee Day Count"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          },
          "persisted": {
            "type": "boolean",
            "title": "Persisted",
            "default": false
          },
          "run_created": {
            "type": "boolean",
            "title": "Run Created",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "valid",
          "schema_version",
          "row_count",
          "employee_day_count",
          "errors"
        ],
        "title": "DatasetValidationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "synthetic_only": {
            "type": "boolean",
            "title": "Synthetic Only"
          }
        },
        "type": "object",
        "required": ["status", "synthetic_only"],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
