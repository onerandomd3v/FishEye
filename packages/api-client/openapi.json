            "type": "string",
            "title": "Created At"
          },
          "created": {
            "type": "boolean",
            "title": "Created"
          },
          "synthetic_only": {
            "type": "boolean",
            "title": "Synthetic Only",
            "default": true
          },
          "run_created": {
            "type": "boolean",
            "title": "Run Created",
            "default": false
          },
          "risk_calculated": {
            "type": "boolean",
            "title": "Risk Calculated",
            "default": false
          }
        },
        "type": "object",
