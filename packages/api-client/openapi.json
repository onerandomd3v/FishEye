          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": ["items", "limit", "offset", "total", "has_more"],
        "title": "DatasetListResponse"
      },
      "DatasetMetadataResponse": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "imported"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256"
          },
          "schema_version": {
            "type": "string",
            "title": "Schema Version"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "employee_day_count": {
            "type": "integer",
            "title": "Employee Day Count"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "preparation_status": {
            "type": "string",
            "title": "Preparation Status"
          },
          "prepared_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prepared At"
          },
          "analysis_manifest_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Analysis Manifest Sha256"
          },
          "synthetic_only": {
            "type": "boolean",
            "title": "Synthetic Only",
            "default": true
          },
          "evaluation_status": {
            "type": "string",
            "title": "Evaluation Status",
            "default": "not_run"
          },
          "ground_truth_usage": {
            "type": "string",
            "title": "Ground Truth Usage",
            "default": "calibration_for_threshold_selection; evaluation_for_metrics; never_a_detector_feature"
          },
          "run_created": {
            "type": "boolean",
            "title": "Run Created",
            "default": false
          },
          "risk_calculated": {
            "type": "boolean",
            "title": "Risk Calculated",
            "default": false
          }
        },
